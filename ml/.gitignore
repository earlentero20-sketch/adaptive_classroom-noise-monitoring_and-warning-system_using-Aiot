# ml/.gitignore  (ML-specific rules, scoped to the ml/ folder only)
# Whether the repository also needs a root-level .gitignore is TBD (team),
# because it would affect other members' folders.
#
# Dataset audio and private metadata belong under data/ and stay out of Git.
# CSV exceptions are limited to shareable, header-only schema examples.

# Audio and video (private recordings, public-dataset audio, ClassBank video)
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.m4a
*.aac
*.aiff
*.wma
*.mp4
*.m4v
*.mov
*.mkv
*.avi
*.webm

# Downloaded dataset archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Everything under data/ stays out of Git, except folder placeholders and schema examples.
data/**
!data/**/
!data/**/.gitkeep
!data/metadata/classroom_metadata.example.csv
!data/metadata/classroom_recording_log.example.csv

# Regenerable ML arrays
*.npy
*.npz

# Generated models and run reports (created only after an approved real-data run)
artifacts/

# Secrets
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
