# Local-development template only. Values are not loaded automatically.
# Replace USER and PASSWORD with a dedicated local PostgreSQL role; URL-encode reserved characters.
SONIQ_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/soniq_db

# Backend listener defaults to local-only. For a trusted private LAN, set
# BACKEND_HOST=0.0.0.0; see docs/LAN_CONNECTIVITY.md before opening the firewall.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Project warning limits. The backend rejects weaker values.
WARNING_THRESHOLD_DB_SPL=75
MAX_INPUT_AGE_SECONDS=30

# Optional; set only to a trusted, project-produced model artifact.
# SONIQ_AUDIO_MODEL_PATH=C:/path/to/trusted/model.joblib

# Optional; repository defaults are min=1 and max=5.
# SONIQ_DB_POOL_MIN_SIZE=1
# SONIQ_DB_POOL_MAX_SIZE=5
