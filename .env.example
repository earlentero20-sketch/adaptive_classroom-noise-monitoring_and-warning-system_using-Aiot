# Template only: the backend and migration command read SONIQ_DATABASE_URL
# from the current process environment; they do not automatically load .env.
# Replace USER, PASSWORD, and DATABASE with the local PostgreSQL role,
# password, and database that you create. URL-encode reserved characters in
# USER or PASSWORD.
SONIQ_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Optional. Set only to a compatible, trusted local model artifact.
# The backend launcher requires this for its model preflight.
# SONIQ_AUDIO_MODEL_PATH=

# Optional; repository defaults are min=1 and max=5.
# SONIQ_DB_POOL_MIN_SIZE=1$env:SONIQ_DATABASE_URL = "postgresql://postgres:mypassword123@localhost:5432/soniq_db"